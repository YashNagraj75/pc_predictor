# Copy to .env and edit; scripts read these from the environment (e.g. `set -a; . ./.env; set +a`).
PCP_ROOT=/path/to/pc_predictor            # repository checkout on the machine that runs the jobs
PCP_BACKUP_DIR=/path/to/pc_predictor_runs_backup   # tools/fetch_merge.sh: clone of the backup results repo
PCP_VERIFY_DIR=/path/to/pc_predictor_runs_verify   # tools/verify_merge.sh: scratch clone used for verification
UV=uv                                     # uv executable used by tools/provision.sh and tools/rebuild.sh
